{
  "name": "@yeger/vue-masonry-wall",
  "version": "6.1.4",
  "description": "Responsive masonry layout with SSR support and zero dependencies for Vue 3.",
  "keywords": [
    "component",
    "masonry",
    "plugin",
    "vue",
    "wall"
  ],
  "homepage": "https://vue-masonry-wall.janmueller.dev",
  "bugs": {
    "url": "https://github.com/DerYeger/yeger/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jan Müller",
    "url": "https://github.com/DerYeger"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DerYeger/yeger.git",
    "directory": "packages/vue-masonry-wall"
  },
  "files": [
    "dist/*",
    "src/**/*.vue"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@yeger/debounce": "2.0.20"
  },
  "devDependencies": {
    "@types/resize-observer-browser": "0.1.11",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "@vue/test-utils": "2.4.11",
    "publint": "0.3.21",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "vue": "3.5.38",
    "vue-tsc": "3.3.5",
    "@yeger/tsconfig": "2.1.3",
    "@yeger/vitest-utils": "1.2.5",
    "vue-fast-mount": "0.4.4"
  },
  "peerDependencies": {
    "vue": "^3.5.19"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "publint": "publint run --strict",
    "test": "vitest",
    "typecheck": "vue-tsc"
  }
}